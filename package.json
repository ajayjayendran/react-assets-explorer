{
  "name": "assets-viewer",
  "version": "1.0.0",
  "description": "A React-based Assets Viewer with CLI and Express server",
  "main": "dist/cli/index.js",
  "type": "module",
  "bin": {
    "assets-viewer": "dist/cli/index.js"
  },
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run build",
    "test": "echo \"No tests specified\" && exit 0",
    "start-server": "ts-node server/index.ts",
    "start-viewer": "react-scripts start",
    "start": "ts-node cli/index.mjs start",
    "init": "ts-node cli/index.mjs init" 
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/commander": "^2.12.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.4",
    "@types/rollup-plugin-peer-deps-external": "^2.2.5",
    "commander": "^12.1.0",
    "concurrently": "^9.0.1",
    "express": "^4.21.0",
    "rollup": "^4.24.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-preserve-shebang": "^1.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
